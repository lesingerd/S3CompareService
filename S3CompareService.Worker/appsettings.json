{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "IdleMon": {
    "Enabled": false,
    "AgentUrl": "http://127.0.0.1:47100",
    "ApiKeyEnv": "IDLEMON_APIKEY",
    "Instance": "default",
    "HeartbeatIntervalSeconds": 60,
    "MetricsIntervalSeconds": 300,
    "SpoolDirectory": "",
    "SpoolMaxMegabytes": 50,
    "DryRunFile": "",
    "IncludeBucketNames": true,
    "IncludeObjectKeys": false,
    "OverdueMultiplier": 2,
    "StaleResultMultiplier": 3,
    "StuckScanMinutes": 15
  }
}
